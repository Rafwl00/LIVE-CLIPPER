def find_user(ident):
    ident = str(ident).strip().lower()
    if ident == ADMIN_EMAIL.lower() and ADMIN_NAME in USERS:
        return ADMIN_NAME
    if "@" in ident:
        return next((k for k, r in USERS.items() if r.get("email", "").lower() == ident), None)
    return ident if ident in USERS else None


def make_key(email):
    base = re.sub(r"[^a-z0-9_.-]", "", email.split("@")[0].lower())[:12] or "user"
    h = hashlib.sha1(email.encode()).hexdigest()
    n = 4
    while f"{base}_{h[:n]}" in USERS or reserved(f"{base}_{h[:n]}"):
        n += 2
    return f"{base}_{h[:n]}"


def oauth_user(prefix, ident, email):
    if str(email).lower() == ADMIN_EMAIL.lower():
        email = ""
    ident = re.sub(r"[^a-z0-9-]", "", str(ident).lower())
    if not ident:
        return None
    key = f"{prefix}_{ident}"[:34]
    if key not in USERS:
        if not CFG["signup_open"]:
            return None
        new_user(key, secrets.token_urlsafe(24), "user", int(CFG["signup_limit"]), int(CFG["signup_channels"]))
        USERS[key].update(email=email or "", display="@" + ident, provider=prefix)
        save_users()
    return key if USERS[key].get("active", True) else None


