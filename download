def analyze(vol, chat):
    """Nota do clipe: volume (pico, média) e onde o chat disparou."""
    if not vol:
        return {}
    n = len(vol)
    vp = max(vol); vt = vol.index(vp); va = sum(vol) / n
    chat = list(chat)[:n]
    c5 = [sum(chat[i:i + 5]) for i in range(max(len(chat) - 4, 1))] if chat else [0]
    cm = max(c5); ctt = c5.index(cm) + 2 if cm else 0
    step = max(1, n // 60)
    wave = [round(max(vol[i:i + step])) for i in range(0, n, step)]
    cw = [sum(chat[i:i + step]) for i in range(0, len(chat), step)] if chat else []
    score = round(min(vp / max(va, 1) / 4, 1) * 60 + min(cm / 20, 1) * 40) if cm else round(min(vp / max(va, 1) / 3, 1) * 100)
    return {"vp": round(vp), "va": round(va), "vt": vt, "vi": min(vt // step, len(wave) - 1), "cm": cm, "ct": sum(chat),
            "ctt": ctt, "ci": min(ctt // step, max(len(cw) - 1, 0)), "wave": wave, "cw": cw, "score": score}


def make_clip(src, start, dur, folder, reason, vol, chat, reencode=False):
    d = os.path.join(CFG["outdir"], "Biblioteca", getattr(CTX, "user", None) or "_", folder)
    os.makedirs(d, exist_ok=True)
    out = os.path.join(d, f"clipe_{datetime.now().strftime('%Y%m%d_%H%M%S_%f')[:-3]}.mp4")
    cmd = ["ffmpeg", "-y", "-loglevel", "error", "-ss", str(start), "-i", src, "-t", str(dur)]
    if CFG["vertical"]:
        vf = ("split[a][b];[a]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,boxblur=25:5[bg];"
              "[b]scale=1080:-2[fg];[bg][fg]overlay=(W-w)/2:(H-h)/2")
        cmd += ["-vf", vf, "-c:v", "libx264", "-preset", "veryfast", "-crf", "21", "-c:a", "aac"]
    elif reencode:
        cmd += ["-c:v", "libx264", "-preset", "veryfast", "-crf", "22", "-c:a", "aac"]
    else:
        cmd += ["-c", "copy"]
    r = run(cmd + ["-movflags", "+faststart", out], capture_output=True)
    if r.returncode != 0 or not os.path.exists(out):
        return None
    info = {"file": out, "rel": os.path.relpath(out, CFG["outdir"]).replace("\\", "/"), "name": os.path.basename(out),
            "reason": reason, "at": datetime.now().strftime("%H:%M:%S"), "live_t": start, "dur": dur,
            "stats": analyze(vol[start:start + dur], chat[start:start + dur])}
    vt = (info["stats"] or {}).get("vt", dur // 2)
    run(["ffmpeg", "-y", "-loglevel", "error", "-ss", str(max(0, min(vt, dur - 1))), "-i", out, "-frames:v", "1",
         "-vf", "scale=480:-2", out[:-4] + ".jpg"], capture_output=True)
    json.dump(info, open(out[:-4] + ".json", "w", encoding="utf-8"))
    return info


def low_score(info):
    """Apaga o clipe e devolve True se a nota ficou abaixo do mínimo configurado."""
    if info.get("stats", {}).get("score", 100) >= CFG.get("minscore", 0):
        return False
    for ext in (".mp4", ".json", ".jpg"):
        try:
            os.remove(info["file"][:-4] + ext)
        except Exception:
            pass
    return True


AI_ERR = [""]


def ai_title(info, game):
    """Pede à API da Anthropic um título curto olhando 3 quadros do clipe."""
    st = info.get("stats") or {}
    vt, dur = st.get("vt", 5), info.get("dur", 30)
    frames = []
    for t in (max(0, vt - 3), vt, min(dur - 1, vt + 3)):
        r = run(["ffmpeg", "-loglevel", "error", "-ss", str(max(0, t)), "-i", info["file"], "-frames:v", "1",
                 "-vf", "scale=640:-2", "-f", "image2pipe", "-vcodec", "mjpeg", "pipe:1"], capture_output=True)
        if r.stdout:
            frames.append(base64.b64encode(r.stdout).decode())
    if not frames:
        return None
    jogo = f" do jogo {game}" if game else ""
    txt = (f"Estes quadros são de um clipe de uma live{jogo}. Momento detectado: {info.get('reason')}. "
           "Escreva um título curto em português do Brasil (máximo 7 palavras) dizendo o que acontece na tela, "
           "no estilo de título de clipe. Responda só com o título, sem aspas e sem pontuação final.")
    body = {"model": CFG.get("aimodel", "claude-haiku-5-5"), "max_tokens": 60, "messages": [{"role": "user", "content": [
        *[{"type": "image", "source": {"type": "base64", "media_type": "image/jpeg", "data": f}} for f in frames],
        {"type": "text", "text": txt}]}]}
    req = urllib.request.Request("https://api.anthropic.com/v1/messages", json.dumps(body).encode(),
                                 {"x-api-key": CFG["apikey"], "anthropic-version": "2023-06-01",
                                  "content-type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=45) as r:
            j = json.load(r)
        AI_ERR[0] = ""
        t = "".join(b.get("text", "") for b in j.get("content", []) if b.get("type") == "text").strip()
        return t.splitlines()[0] if t else None
    except urllib.error.HTTPError as e:
        AI_ERR[0] = f"erro {e.code}: " + e.read().decode("utf-8", "ignore")[:110]
    except Exception as e:
        AI_ERR[0] = str(e)[:110]
    return None


def finish_clip(info, meta):
    """Renomeia o clipe: 'Jogo - momento - nota' ou 'Jogo - título feito pela IA'."""
    mode = CFG.get("rename", "off")
    if mode == "off":
        return info
    meta = meta or {}
    game = meta.get("game")
    title = ai_title(info, game) if mode == "ai" and CFG.get("apikey") else None
    st = info.get("stats") or {}
    if title:
        base = f"{game} - {title}" if game else title
    else:
        base = " - ".join(x for x in (game or meta.get("who"), info.get("reason"),
                                       f"nota {st['score']}" if "score" in st else "") if x)
    base = re.sub(r'[\\/:*?"<>|\r\n]+', "", base).strip()[:110]
    if not base:
        return info
    d, new, n = os.path.dirname(info["file"]), None, 1
    new = os.path.join(d, base + ".mp4")
    while os.path.exists(new):
        n += 1
        new = os.path.join(d, f"{base} ({n}).mp4")
    try:
        os.rename(info["file"], new)
        os.rename(info["file"][:-4] + ".json", new[:-4] + ".json")
        if os.path.exists(info["file"][:-4] + ".jpg"):
            os.rename(info["file"][:-4] + ".jpg", new[:-4] + ".jpg")
    except Exception:
        return info
    info.update(file=new, name=os.path.basename(new), title=base,
                rel=os.path.relpath(new, CFG["outdir"]).replace("\\", "/"))
    json.dump(info, open(new[:-4] + ".json", "w", encoding="utf-8"))
    return info


def run(cmd, **kw):
    return subprocess.run(cmd, creationflags=NOWIN, **kw)


class Monitor(threading.Thread):
    def __init__(self, url, owner):
        super().__init__(daemon=True)
        self.url, self.name, self.owner = url, chan_name(url), owner
        self.key = f"{owner}|{url}"
        self.stop_flag = threading.Event()
        self.status = "procurando"
        self.audio = deque(maxlen=120)
        self.chatH = deque(maxlen=120)
        self.chat_count = 0
        self.sec = 0
        self.last_trig = -999
        self.clips = []
        self.live_file = None
        self.started = None
        self.procs = []
        self.log = "Verificando se a live está no ar..."
        self.err = False
        self.paused = False
        self.vall, self.call = [], []
        self.hot_run = 0
        self.meta, self.rid = {}, 0

    # ---------- chat (Twitch, IRC anônimo) ----------
    def chat_loop(self):
        if "twitch.tv" not in self.url:
            return
        while not self.stop_flag.is_set() and self.status == "gravando":
            try:
                s = socket.create_connection(("irc.chat.twitch.tv", 6667), timeout=30)
                s.sendall(f"PASS SCHMOOPIIE\r\nNICK justinfan{int(time.time()) % 99999}\r\nJOIN #{self.name.lower()}\r\n".encode())
                s.settimeout(30)
                buf = ""
                while not self.stop_flag.is_set() and self.status == "gravando":
                    data = s.recv(4096).decode("utf-8", "ignore")
                    if not data:
                        break
                    buf += data
                    *lines, buf = buf.split("\r\n")
                    for ln in lines:
                        if ln.startswith("PING"):
                            s.sendall(b"PONG :tmi.twitch.tv\r\n")
                        elif "PRIVMSG" in ln:
                            self.chat_count += 1
            except Exception:
                time.sleep(5)

    def meta_loop(self, rid):
        while self.rid == rid and self.status == "gravando" and not self.stop_flag.is_set():
            try:
                r = run(SL + ["--json", self.url], capture_output=True, timeout=60)
                m = json.loads(r.stdout.decode("utf-8", "ignore")).get("metadata") or {}
                self.meta = {"game": m.get("category"), "who": m.get("author") or self.name, "title": m.get("title")}
            except Exception:
                pass
            self.stop_flag.wait(300)

    # ---------- ciclo principal ----------
    def is_live(self):
        if not SL:
            self.log = "ERRO: streamlink não encontrado. Rode: pip install streamlink"
            self.err = True
            return False
        if not shutil.which("ffmpeg"):
            self.log = "ERRO: ffmpeg não encontrado. Instale e reabra o terminal."
            self.err = True
            return False
        try:
            r = run(SL + ["--stream-url", self.url, "best"], capture_output=True, timeout=60)
        except Exception as e:
            self.log = f"ERRO ao checar a live: {e}"
            self.err = True
            return False
        if r.returncode == 0:
            self.err = False
            return True
        msg = (r.stderr or r.stdout or b"").decode("utf-8", "ignore").strip().splitlines()
        last = msg[-1] if msg else ""
        if "No playable streams" in last or "offline" in last.lower():
            self.err, self.log = False, "Live offline. Verificando de novo em instantes..."
        else:
            self.err, self.log = True, f"Streamlink: {last[:140]}"
        return False

    def run(self):
        CTX.user = self.owner
        while not self.stop_flag.is_set():
            if self.paused:
                self.status, self.log = "pausado", "Pausado. Clique em Retomar para voltar a vigiar."
                self.stop_flag.wait(2)
                continue
            self.status = "procurando"
            if self.is_live():
                self.record()
            self.status = ("erro" if self.err else "offline") if not self.stop_flag.is_set() else "parado"
            self.stop_flag.wait(30)

    def record(self):
        d = os.path.join(CFG["outdir"], "Lives", self.owner, self.name)
        os.makedirs(d, exist_ok=True)
        ts = datetime.now().strftime("%Y-%m-%d_%Hh%Mm")
        self.live_file = os.path.join(d, f"{self.name}_{ts}.ts")
        self.sec, self.last_trig = 0, -999
        self.audio.clear(); self.chatH.clear(); self.vall, self.call, self.hot_run = [], [], 0; self.chat_count = 0
        self.status, self.started = "gravando", time.time()
        self.log = "Gravando a live e analisando..."
        try:
            p1 = subprocess.Popen(SL + ["-O", "--twitch-disable-ads", self.url, "best"],
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN)
            p2 = subprocess.Popen(["ffmpeg", "-loglevel", "quiet", "-i", "pipe:0",
                                   "-c", "copy", "-f", "mpegts", self.live_file,
                                   "-vn", "-ac", "1", "-ar", "8000", "-f", "s16le", "pipe:1"],
                                  stdin=p1.stdout, stdout=subprocess.PIPE, creationflags=NOWIN)
            self.procs = [p1, p2]
            p1.stdout.close()
        except Exception as e:
            self.log = f"Erro ao iniciar: {e}"
            return
        self.rid += 1
        threading.Thread(target=self.meta_loop, args=(self.rid,), daemon=True).start()
        threading.Thread(target=self.chat_loop, daemon=True).start()
        buf, size = b"", 16000  # 1 segundo de áudio (8000 amostras * 2 bytes)
        while not self.stop_flag.is_set() and not self.paused:
            chunk = p2.stdout.read(size - len(buf))
            if not chunk:
                break
            buf += chunk
            if len(buf) < size:
                continue
            n = len(buf) // 2
            samples = struct.unpack(f"<{n}h", buf[: n * 2])
            buf = b""
            rms = math.sqrt(sum(x * x for x in samples) / n)
            self.tick(rms)
        self.stop_proc()
        self.status = "finalizando"
        self.finalize()

    def stop_proc(self):
        for p in self.procs:
            try:
                p.terminate()
            except Exception:
                pass

    # ---------- detecção ----------
    def tick(self, rms):
        self.sec += 1
        chat, self.chat_count = self.chat_count, 0
        self.audio.append(rms); self.chatH.append(chat); self.vall.append(rms); self.call.append(chat)
        if len(self.audio) < 30:
            return
        base = list(self.audio)[:-1][-90:]
        m = sum(base) / len(base)
        sd = math.sqrt(sum((x - m) ** 2 for x in base) / len(base))
        z = (rms - m) / max(sd, m * 0.12, 1)
        thr = 4.6 - 0.36 * CFG["sens"]
        reason = None
        mode = CFG.get("mode", "both")
        hot = z > thr and rms > CFG.get("floor", 400)
        self.hot_run = self.hot_run + 1 if hot else 0
        if mode in ("both", "audio") and self.hot_run >= CFG.get("sustain", 3):
            reason = "Pico de áudio"
        if mode in ("both", "chat") and "twitch.tv" in self.url:
            h = list(self.chatH)
            c5 = sum(h[-5:])
            avg5 = (sum(h[:-5]) / max(len(h) - 5, 1)) * 5
            if c5 >= max(8, avg5 * (2 + (10 - CFG["sens"]) * 0.25)):
                reason = "Chat explodiu" if not reason else "Áudio + chat"
        if reason and self.sec - self.last_trig >= CFG["cooldown"]:
            self.last_trig = self.sec
            t = threading.Timer(CFG["post"], self.cut, (self.sec, reason)); t.daemon = True; t.start()
            self.log = f"Momento detectado: {reason}"

    # ---------- corte ----------
    def cut(self, end_sec, reason, pre=None, post=None):
        CTX.user = self.owner
        if not can_clip(self.owner):
            self.log = "🎟️ Seus tokens de hoje acabaram. Eles renovam à meia-noite."
            return
        pre = CFG["pre"] if pre is None else pre
        post = CFG["post"] if post is None else post
        start = max(0, end_sec - pre)
        info = make_clip(self.live_file, start, end_sec - start + post, self.name, reason, self.vall, self.call)
        if info and reason != "Manual" and low_score(info):
            self.log = f"Clipe descartado (nota {info['stats'].get('score')} < {CFG['minscore']})"
            return
        if info:
            info = finish_clip(info, self.meta)
            spend(self.owner)
            self.clips.append(info)
            self.log = f"Clipe salvo: {info['name']}"

    def finalize(self):
        time.sleep(CFG["post"] + 3)
        if self.live_file and os.path.exists(self.live_file):
            mp4 = self.live_file[:-3] + ".mp4"
            r = run(["ffmpeg", "-y", "-loglevel", "error", "-i", self.live_file, "-c", "copy",
                     "-movflags", "+faststart", mp4], capture_output=True)
            if r.returncode == 0 and not CFG["keep_ts"]:
                os.remove(self.live_file)
            self.log = "Live encerrada. Arquivo completo salvo."

    def snapshot(self):
        return {"key": self.key, "owner": self.owner, "url": self.url, "name": self.name, "paused": self.paused, "status": self.status, "log": self.log,
                "audio": [round(x) for x in list(self.audio)[-90:]], "chat": list(self.chatH)[-90:],
                "clips": self.clips[-30:], "elapsed": int(time.time() - self.started) if self.status == "gravando" else 0,
                "file": self.live_file}


MON = {}


def add_channel(url, owner, persist=True):
    url = url.strip()
    if not url or owner not in USERS:
        return "ok"
    if not url.startswith("http"):
        url = "https://twitch.tv/" + url
    key = f"{owner}|{url}"
    if key in MON:
        return "ok"
    if not is_admin(owner) and sum(1 for m in MON.values() if m.owner == owner) >= USERS[owner]["max_channels"]:
        return "limit"
    m = Monitor(url, owner)
    MON[key] = m
    m.start()
    if persist and url not in USERS[owner]["channels"]:
        USERS[owner]["channels"].append(url)
        save_users()
    return "ok"


def remove_channel(key, u):
    m = MON.get(key)
    if m and (m.owner == u or is_owner(u)):
        MON.pop(key, None)
        m.stop_flag.set(); m.stop_proc()
        if m.url in USERS.get(m.owner, {}).get("channels", []):
            USERS[m.owner]["channels"].remove(m.url)
            save_users()


def start_user(name):
    for url in USERS[name]["channels"]:
        add_channel(url, name, False)


def stop_user(name):
    for k in [k for k, m in MON.items() if m.owner == name]:
        m = MON.pop(k)
        m.stop_flag.set(); m.stop_proc()


def open_path(p):
    os.makedirs(p, exist_ok=True)
    if sys.platform.startswith("win"):
        os.startfile(p)
    elif sys.platform == "darwin":
        subprocess.Popen(["open", p])
    else:
        subprocess.Popen(["xdg-open", p])


