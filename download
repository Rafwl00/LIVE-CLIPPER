def hpw(pw, salt):
    return hashlib.pbkdf2_hmac("sha256", pw.encode(), bytes.fromhex(salt), 200_000).hex()


def new_user(name, pw, role="user", limit=30, maxch=3):
    salt = secrets.token_hex(16)
    USERS[name] = {"salt": salt, "hash": hpw(pw, salt), "role": role, "limit": limit, "max_channels": maxch,
                   "active": True, "used": {"d": str(date.today()), "n": 0}, "channels": [], "cfg": {}, "created": time.time()}


def is_owner(u):
    return u == ADMIN_NAME and u in USERS


def is_admin(u):
    return USERS.get(u, {}).get("role") == "admin"


def tokens_left(u):
    """Tokens que sobram hoje (None = ilimitado). Renova à meia-noite."""
    r = USERS.get(u)
    if not r:
        return 0
    if r["role"] == "admin":
        return None
    if r["used"]["d"] != str(date.today()):
        r["used"] = {"d": str(date.today()), "n": 0}
    return max(r["limit"] - r["used"]["n"], 0)


def can_clip(u):
    left = tokens_left(u)
    return left is None or left > 0


def spend(u, n=1):
    r = USERS.get(u)
    if r and r["role"] != "admin":
        tokens_left(u)
        r["used"]["n"] += n
        save_users()


