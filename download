def list_clips():
    base, out = CFG["outdir"], []
    u = getattr(CTX, "user", None)
    roots = [os.path.join(base, "Biblioteca"), os.path.join(base, "Clipes")] if is_owner(u) else [os.path.join(base, "Biblioteca", u or "_")]
    for dp, _, fs in [t for r in roots for t in os.walk(r)]:
        for f in fs:
            if f.lower().endswith(".mp4"):
                p = os.path.join(dp, f)
                st = os.stat(p)
                info = {}
                try:
                    info = json.load(open(p[:-4] + ".json", encoding="utf-8"))
                except Exception:
                    pass
                out.append({"owner": owner_of(p, base), "thumb": (os.path.relpath(p[:-4] + ".jpg", base).replace("\\", "/") if os.path.exists(p[:-4] + ".jpg") else None),
                            "dur": info.get("dur"), "fav": bool(info.get("fav")), "posted": bool(info.get("posted")), "stats": info.get("stats"), "reason": info.get("reason"), "title": info.get("title"), "rel": os.path.relpath(p, base).replace("\\", "/"), "chan": os.path.basename(dp),
                            "mt": st.st_mtime, "mb": round(st.st_size / 1048576, 1),
                            "when": datetime.fromtimestamp(st.st_mtime).strftime("%d/%m %H:%M")})
    out.sort(key=lambda x: -x["mt"])
    return out


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, obj, code=200, ctype="application/json"):
        body = obj if isinstance(obj, bytes) else json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        if getattr(self, "_ck", None) is not None:
            self.send_header("Set-Cookie", f"csid={self._ck}; Path=/; HttpOnly; SameSite=Lax; Max-Age={2592000 if self._ck else 0}")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def me(self):
        m = re.search(r"csid=([\w\-]+)", self.headers.get("Cookie", ""))
        u = SESS.get(m.group(1)) if m else None
        return u if u in USERS and USERS[u].get("active", True) else None

    def go(self, url, ck=None):
        self.send_response(302)
        self.send_header("Location", url)
        if ck:
            self.send_header("Set-Cookie", f"csid={ck}; Path=/; HttpOnly; SameSite=Lax; Max-Age=2592000")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def gh_start(self):
        from urllib.parse import urlencode
        if not (CFG["gh_id"] and CFG["gh_secret"]):
            return self.go("/?err=gh_off")
        st = secrets.token_urlsafe(16)
        OAUTH[st] = time.time() + 600
        host = self.headers.get("Host", f"localhost:{PORT}")
        self.go("https://github.com/login/oauth/authorize?" + urlencode(
            {"client_id": CFG["gh_id"], "redirect_uri": f"http://{host}/auth/github/callback",
             "scope": "read:user user:email", "state": st}))

    def gh_callback(self):
        from urllib.parse import urlparse, parse_qs, urlencode
        q = parse_qs(urlparse(self.path).query)
        st, code = q.get("state", [""])[0], q.get("code", [""])[0]
        if OAUTH.pop(st, 0) < time.time() or not code:
            return self.go("/?err=github")
        try:
            req = urllib.request.Request("https://github.com/login/oauth/access_token", urlencode(
                {"client_id": CFG["gh_id"], "client_secret": CFG["gh_secret"], "code": code}).encode(),
                {"Accept": "application/json"})
            tok = json.load(urllib.request.urlopen(req, timeout=20)).get("access_token")
            hdr = {"Authorization": f"Bearer {tok}", "User-Agent": "Clipfy", "Accept": "application/vnd.github+json"}
            gu = json.load(urllib.request.urlopen(urllib.request.Request("https://api.github.com/user", headers=hdr), timeout=20))
            email = gu.get("email") or ""
            if not email:
                try:
                    em = json.load(urllib.request.urlopen(urllib.request.Request("https://api.github.com/user/emails", headers=hdr), timeout=20))
                    email = next((e["email"] for e in em if e.get("primary") and e.get("verified")), "")
                except Exception:
                    pass
        except Exception:
            return self.go("/?err=github")
        if not tok or not gu.get("login"):
            return self.go("/?err=github")
        key = oauth_user("gh", gu["login"], email)
        if not key:
            return self.go("/?err=fechado")
        USERS[key]["last"] = time.time()
        sid = secrets.token_urlsafe(24)
        SESS[sid] = key
        self.go("/", sid)

    def serve_file(self, dl=False):
        from urllib.parse import urlparse, parse_qs, quote
        rel = parse_qs(urlparse(self.path).query).get("p", [""])[0]
        base = os.path.realpath(CFG["outdir"])
        p = os.path.realpath(os.path.join(base, rel))
        rp = os.path.relpath(p, base).replace("\\", "/")
        if not p.startswith(base + os.sep) or not os.path.isfile(p) or not can_access(rp, CTX.user):
            return self.send({"err": 1}, 404)
        size = os.path.getsize(p)
        a, b, code = 0, size - 1, 200
        rng = self.headers.get("Range")
        if rng and rng.startswith("bytes="):
            s0, _, e0 = rng[6:].partition("-")
            a = int(s0 or 0)
            b = min(int(e0), size - 1) if e0 else size - 1
            code = 206
        self.send_response(code)
        self.send_header("Content-Type", "image/jpeg" if p.endswith(".jpg") else "video/mp4")
        self.send_header("Accept-Ranges", "bytes")
        if dl:
            self.send_header("Content-Disposition", "attachment; filename*=UTF-8\'\'" + quote(os.path.basename(p)))
        self.send_header("Content-Length", str(b - a + 1))
        if code == 206:
            self.send_header("Content-Range", f"bytes {a}-{b}/{size}")
        self.end_headers()
        try:
            with open(p, "rb") as f:
                f.seek(a)
                left = b - a + 1
                while left > 0:
                    d = f.read(min(65536, left))
                    if not d:
                        break
                    self.wfile.write(d)
                    left -= len(d)
        except (BrokenPipeError, ConnectionError):
            pass

    def do_GET(self):
        CTX.user = u = self.me()
        path = self.path.split("?")[0]
        if path == "/api/me":
            return self.send(me_info(u))
        if path == "/logo.png":
            return self.send(base64.b64decode(LOGO_B64), ctype="image/png")
        if path == "/favicon.png":
            return self.send(base64.b64decode(FAV_B64), ctype="image/png")
        if path == "/auth/github":
            return self.gh_start()
        if path == "/auth/github/callback":
            return self.gh_callback()
        if not path.startswith(("/api", "/file", "/download")):
            return self.send(PAGE.encode(), ctype="text/html")
        if not u:
            return self.send({"err": "login"}, 401)
        adm, own = is_admin(u), is_owner(u)
        if path == "/download":
            return self.serve_file(True)
        if path == "/file":
            return self.serve_file()
        if path == "/api/clips":
            return self.send({"clips": list_clips()})
        if path == "/api/admin/users":
            if not adm:
                return self.send({"err": "Apenas administradores"}, 403)
            out = []
            for k, r in USERS.items():
                tokens_left(k)
                out.append({"name": k, "display": r.get("display") or r.get("email") or k, "role": r["role"], "limit": r["limit"], "used": r["used"]["n"],
                            "max_channels": r["max_channels"], "active": r.get("active", True), "channels": len(r["channels"]),
                            "email": r.get("email", ""), "provider": r.get("provider", "manual"), "created": r.get("created"),
                            "last": r.get("last"), "owner": k == ADMIN_NAME})
            host = self.headers.get("Host", f"localhost:{PORT}")
            return self.send({"users": out, "own": own, "config": None if not own else {
                "signup_open": bool(CFG["signup_open"]), "signup_limit": CFG["signup_limit"], "signup_channels": CFG["signup_channels"],
                "gh_id": CFG["gh_id"], "gh_set": bool(CFG["gh_secret"]), "callback": f"http://{host}/auth/github/callback"}})
        if path == "/api/state":
            cl = list_clips()
            t0 = time.mktime(datetime.now().replace(hour=0, minute=0, second=0).timetuple())
            miss = (["streamlink"] if not SL else []) + ([] if shutil.which("ffmpeg") else ["ffmpeg"])
            return self.send({"cfg": {k: CFG[k] for k in DEFAULT if k not in ("channels", "apikey", "gh_secret", "gh_id", "signup_open", "signup_limit", "signup_channels")}, "missing": miss,
                              "me": me_info(u), "recent": [{k: x[k] for k in ("rel", "title", "chan", "thumb", "stats", "posted", "fav", "when", "dur", "reason")} for x in cl[:6]],
                              "ai_err": AI_ERR[0], "has_key": bool(CFG.get("apikey")),
                              "stats": {"favs": sum(1 for x in cl if x["fav"]), "total": len(cl),
                                        "posted": sum(1 for x in cl if x["posted"]), "pending": sum(1 for x in cl if not x["posted"]),
                                        "best": max([x["stats"]["score"] for x in cl if x.get("stats") and x["stats"].get("score") is not None], default=None),
                                        "week": [{"d": str(date.today() - timedelta(days=i)), "n": sum(1 for x in cl if date.fromtimestamp(x["mt"]) == date.today() - timedelta(days=i))} for i in range(6, -1, -1)],
                                        "today": sum(1 for x in cl if x["mt"] >= t0)},
                              "channels": [m.snapshot() for m in MON.values() if own or m.owner == u]})
        self.send({"err": "?"}, 404)

    def do_POST(self):
        CTX.user = u = self.me()
        self._ck = None
        n = int(self.headers.get("Content-Length", 0) or 0)
        try:
            b = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            b = {}
        P, res = self.path, {"ok": True}
        # ---- rotas públicas ----
        if P == "/api/setup" and ADMIN_NAME not in USERS:
            name, pw = str(b.get("user", "")).strip().lower(), str(b.get("pass", ""))
            if name != ADMIN_NAME:
                return self.send({"err": f"O primeiro acesso é exclusivo do administrador ({ADMIN_NAME})."})
            if len(pw) < 6:
                return self.send({"err": "A senha precisa ter no mínimo 6 caracteres."})
            new_user(name, pw, "admin", 0, 0)
            USERS[name].update(email=ADMIN_EMAIL, display=ADMIN_NAME)
            USERS[name]["channels"] = list(dict.get(CFG, "channels", []))
            save_users(); start_user(name)
            sid = secrets.token_urlsafe(24); SESS[sid] = name; self._ck = sid
            return self.send(res)
        if P == "/api/login":
            name = find_user(b.get("user", ""))
            r = USERS.get(name)
            if not (r and r.get("active", True) and hmac.compare_digest(hpw(str(b.get("pass", "")), r["salt"]), r["hash"])):
                time.sleep(0.6)
                return self.send({"err": "Usuário ou senha incorretos"}, 401)
            USERS[name]["last"] = time.time(); save_users()
            sid = secrets.token_urlsafe(24); SESS[sid] = name; self._ck = sid
            return self.send(res)
        if P == "/api/signup":
            email, pw = str(b.get("email", "")).strip().lower(), str(b.get("pass", ""))
            if ADMIN_NAME not in USERS or not CFG["signup_open"]:
                return self.send({"err": "Os cadastros estão fechados no momento."})
            if not re.fullmatch(r"[^@\s]{1,64}@[^@\s]+\.[^@\s]{2,}", email):
                return self.send({"err": "Digite um e-mail válido."})
            if len(pw) < 6:
                return self.send({"err": "A senha precisa ter no mínimo 6 caracteres."})
            if find_user(email):
                return self.send({"err": "Esse e-mail já tem uma conta. Use a aba Entrar."})
            key = make_key(email)
            new_user(key, pw, "user", int(CFG["signup_limit"]), int(CFG["signup_channels"]))
            USERS[key].update(email=email, display=email, provider="email")
            save_users()
            sid = secrets.token_urlsafe(24); SESS[sid] = key; self._ck = sid
            return self.send(res)
        if P == "/api/logout":
            m = re.search(r"csid=([\w\-]+)", self.headers.get("Cookie", ""))
            SESS.pop(m.group(1) if m else "", None); self._ck = ""
            return self.send(res)
        if not u:
            return self.send({"err": "login"}, 401)
        adm, own = is_admin(u), is_owner(u)
        # ---- administração ----
        if P.startswith("/api/admin/"):
            if not adm:
                return self.send({"err": "Apenas administradores"}, 403)
            op, name = P.rsplit("/", 1)[1], str(b.get("name", "")).strip().lower()
            if op == "config":
                if not own:
                    return self.send({"err": "Só o dono pode mudar essas configurações"})
                if "signup_open" in b: CFG["signup_open"] = bool(b["signup_open"])
                for k in ("signup_limit", "signup_channels"):
                    if k in b: CFG[k] = max(0, int(b[k]))
                if "gh_id" in b: CFG["gh_id"] = str(b["gh_id"]).strip()
                if b.get("gh_secret"): CFG["gh_secret"] = str(b["gh_secret"]).strip()
                save_cfg()
                return self.send(res)
            if op == "create":
                if not re.fullmatch(r"[a-z0-9_.-]{3,20}", name):
                    res = {"err": "Nome: 3 a 20 letras minúsculas/números"}
                elif name in USERS:
                    res = {"err": "Esse usuário já existe"}
                elif reserved(name):
                    res = {"err": "Esse nome é reservado ao administrador"}
                elif len(str(b.get("pass", ""))) < 6:
                    res = {"err": "Senha com no mínimo 6 caracteres"}
                else:
                    new_user(name, str(b["pass"]), "user",
                             max(0, int(b.get("limit", 30))), max(0, int(b.get("max_channels", 3))))
                    save_users()
            elif name not in USERS:
                res = {"err": "Usuário não existe"}
            elif USERS[name]["role"] == "admin" and not own:
                res = {"err": "Só o dono pode alterar administradores"}
            elif op == "update":
                r = USERS[name]
                if "limit" in b: r["limit"] = max(0, int(b["limit"]))
                if "max_channels" in b: r["max_channels"] = max(0, int(b["max_channels"]))
                if "role" in b:
                    if name == ADMIN_NAME:
                        res = {"err": "O dono não pode perder o cargo"}
                    elif not own:
                        res = {"err": "Só o dono pode dar ou tirar o cargo de administrador"}
                    else:
                        r["role"] = "admin" if b["role"] == "admin" else "user"
                if b.get("reset"): r["used"] = {"d": str(date.today()), "n": 0}
                if len(str(b.get("pass", ""))) >= 6:
                    r["salt"] = secrets.token_hex(16); r["hash"] = hpw(str(b["pass"]), r["salt"])
                if "active" in b:
                    if name == u and not b["active"]:
                        res = {"err": "Você não pode desativar a si mesmo"}
                    else:
                        r["active"] = bool(b["active"])
                        stop_user(name) if not r["active"] else start_user(name)
                save_users()
            elif op == "delete":
                if name == u or name == ADMIN_NAME:
                    res = {"err": "Essa conta não pode ser excluída"}
                else:
                    stop_user(name); USERS.pop(name); save_users()
                    for k in [k for k, v in SESS.items() if v == name]: SESS.pop(k)
            return self.send(res)
        # ---- usuário comum ----
        if P == "/api/passwd":
            r = USERS[u]
            if not hmac.compare_digest(hpw(str(b.get("old", "")), r["salt"]), r["hash"]):
                res = {"err": "Senha atual incorreta"}
