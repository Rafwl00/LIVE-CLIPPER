        return USERS[u].get("cfg", {}) if u in USERS and k in USER_KEYS else {}

    def __getitem__(self, k):
        c = self._uc(k)
        return c[k] if k in c else dict.__getitem__(self, k)

    def get(self, k, d=None):
        try:
            return self[k]
        except KeyError:
