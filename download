                res = {"err": "Você atingiu o limite de canais da sua conta"}
        elif P == "/api/remove":
            remove_channel(b.get("url", ""), u)
        elif P == "/api/settings":
            for k in ("sens", "pre", "post", "cooldown", "vertical", "chat", "keep_ts", "outdir", "mode", "floor",
                      "minscore", "sustain", "rename", "apikey"):
                if k in b and not (k == "apikey" and not b[k]) and not (k == "outdir" and not own):
                    CFG[k] = b[k]
            save_users(); save_cfg()
        elif P in ("/api/clip", "/api/pause"):
            m = MON.get(b.get("url"))
            if m and (own or m.owner == u):
                if P == "/api/pause":
                    m.paused = not m.paused
                elif m.status == "gravando":
                    threading.Thread(target=m.cut, args=(m.sec, "Manual", 30, 0), daemon=True).start()
        elif P == "/api/fav":
            p = user_file(b.get("rel", ""), u)
            if p:
                try:
                    info = json.load(open(p[:-4] + ".json", encoding="utf-8"))
                except Exception:
                    info = {}
                info["fav"] = not info.get("fav", False)
                json.dump(info, open(p[:-4] + ".json", "w", encoding="utf-8"))
                res = {"fav": info["fav"]}
        elif P == "/api/posted":
            p = user_file(b.get("rel", ""), u)
            if p:
                try:
                    info = json.load(open(p[:-4] + ".json", encoding="utf-8"))
                except Exception:
                    info = {}
                info["posted"] = not info.get("posted", False)
                info["posted_at"] = time.time() if info["posted"] else None
                json.dump(info, open(p[:-4] + ".json", "w", encoding="utf-8"))
                res = {"posted": info["posted"]}
        elif P == "/api/delete":
            p = user_file(b.get("rel", ""), u)
            if p:
                for ext in (".mp4", ".json", ".jpg"):
                    try:
                        os.remove(p[:-4] + ext)
                    except Exception:
                        pass
        elif P == "/api/clean":
            cnt = 0
            for x in list_clips():
                if not x["fav"] and x.get("owner") in (u, None):
                    p = os.path.join(CFG["outdir"], x["rel"])
                    for ext in (".mp4", ".json", ".jpg"):
                        try:
                            os.remove(p[:-4] + ext); cnt += ext == ".mp4"
                        except Exception:
                            pass
            res = {"n": cnt}
        elif P == "/api/open" and own:
            open_path(os.path.join(CFG["outdir"], b.get("sub", "")))
        self.send(res)


